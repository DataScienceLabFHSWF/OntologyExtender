<?xml version="1.0" encoding="utf-8"?>
<rdf:RDF
   xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
   xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
>
  <rdf:Description rdf:about="http://www.semanticweb.org/ontology#hasFacility">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:comment>The facility where the action takes place</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.semanticweb.org/ontology#ActionPrecondition"/>
    <rdfs:range rdf:resource="http://www.semanticweb.org/ontology#Facility"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/ontology#Facility">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment>A physical structure or location where an action takes place</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontology#PlanningDomain"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/ontology#hasFacilityReference">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:comment>The facility referenced in the planning domain</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.semanticweb.org/ontology#PlanningDomain"/>
    <rdfs:range rdf:resource="http://www.semanticweb.org/ontology#Facility"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/ontology#hasRegulatoryDocument">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:comment>The regulatory document that outlines requirements for the action</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.semanticweb.org/ontology#ActionPrecondition"/>
    <rdfs:range rdf:resource="http://www.semanticweb.org/ontology#RegulatoryDocument"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/ontology#RegulatoryDocument">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment>A legal document that outlines requirements and regulations for a specific activity or operation</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontology#ActionPrecondition"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/ontology#License">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment>A legal document granting permission for a specific activity or operation</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontology#ActionPrecondition"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/ontology#isTypeOfLicense">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:comment>Whether the license is a specific type of license</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.semanticweb.org/ontology#ActionPrecondition"/>
    <rdfs:range rdf:resource="http://www.semanticweb.org/ontology#License"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/ontology#Permit">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment>A written authorization granted by an authority to carry out a specific activity or operation</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontology#License"/>
  </rdf:Description>
</rdf:RDF>
