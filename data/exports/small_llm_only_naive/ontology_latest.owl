<?xml version="1.0" encoding="utf-8"?>
<rdf:RDF
   xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
   xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
>
  <rdf:Description rdf:about="http://www.semanticweb.org/ontology#hasHazardousSubstance">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:comment>The hazardous substance or radiation risk associated with the facility</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.semanticweb.org/ontology#Gefahrstoff"/>
    <rdfs:range rdf:resource="http://www.semanticweb.org/ontology#HazardousSubstanceType"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/ontology#hasCapacity">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:comment>The capacity of the facility</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.semanticweb.org/ontology#Anlage"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/ontology#hasShutdownDeadline">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:comment>The deadline for the shutdown of the facility</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.semanticweb.org/ontology#Stilllegungsanforderung"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/ontology#hasTypeOfLicense">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:comment>The type of license required</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.semanticweb.org/ontology#Genehmigung"/>
    <rdfs:range rdf:resource="http://www.semanticweb.org/ontology#LicenseType"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/ontology#hasShutdownRequirements">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:comment>The requirements for the shutdown of the facility</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.semanticweb.org/ontology#Stilllegungsanforderung"/>
    <rdfs:range rdf:resource="http://www.semanticweb.org/ontology#ShutdownRequirementType"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/ontology#hasType">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:comment>The type of the facility</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.semanticweb.org/ontology#Anlage"/>
    <rdfs:range rdf:resource="http://www.semanticweb.org/ontology#NuclearFacilityType"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/ontology#hasName">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:comment>The name of the facility</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.semanticweb.org/ontology#Anlage"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/ontology#requiresTransportRegulations">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:comment>Whether transport regulations are required for the decommissioning project or not</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.semanticweb.org/ontology#Rückbauprojekt"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/ontology#Anlage">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment>A nuclear facility or installation</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontology#ProblemObject"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/ontology#Stilllegungsanforderung">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment>Requirements for the shutdown of a nuclear facility</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontology#DomainRequirement"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/ontology#requiresShutdown">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:comment>Whether a shutdown is required for the decommissioning project or not</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.semanticweb.org/ontology#Rückbauprojekt"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/ontology#isDismantled">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:comment>Whether the facility is dismantled or not</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.semanticweb.org/ontology#Anlage"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/ontology#Rückbauprojekt">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment>A decommissioning project for a nuclear facility</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontology#Plan"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/ontology#hasStartDate">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:comment>The start date of the decommissioning project</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.semanticweb.org/ontology#Rückbauprojekt"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/ontology#hasProjectName">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:comment>The name of the decommissioning project</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.semanticweb.org/ontology#Rückbauprojekt"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/ontology#Gefahrstoff">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment>A hazardous substance or radiation risk associated with a nuclear facility</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontology#ProblemObject"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/ontology#hasEndDate">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:comment>The end date of the decommissioning project</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.semanticweb.org/ontology#Rückbauprojekt"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/ontology#hasTransportRegulationType">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:comment>The type of transport regulation required</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.semanticweb.org/ontology#Transportvorschrift"/>
    <rdfs:range rdf:resource="http://www.semanticweb.org/ontology#TransportRegulationType"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/ontology#Transportvorschrift">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment>Regulations for the transport of plutonium</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontology#DomainConstant"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/ontology#hasTransportRegulationVersion">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:comment>The version of the transport regulation</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.semanticweb.org/ontology#Transportvorschrift"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/ontology#requiresLicense">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:comment>Whether a license is required for the decommissioning project or not</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.semanticweb.org/ontology#Rückbauprojekt"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/ontology#hasExpirationDate">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:comment>The expiration date of the license</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.semanticweb.org/ontology#Genehmigung"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/ontology#Genehmigung">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment>A license or permit required for the dismantling of a nuclear facility</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontology#DomainRequirement"/>
  </rdf:Description>
</rdf:RDF>
