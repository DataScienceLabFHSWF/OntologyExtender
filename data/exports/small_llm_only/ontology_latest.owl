  <rdf:Description rdf:about="http://www.semanticweb.org/ontology#hasDecommissioningStrategy">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:comment>The decommissioning strategy or strategies in place for the facility</rdfs:comment>
    <rdfs:range rdf:resource="http://www.semanticweb.org/ontology#DecommissioningStrategy | DismantlingStrategy"/>
    <rdfs:domain rdf:resource="http://www.semanticweb.org/ontology#Facility"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://purl.org/ai4s/ontology/planning#hasPrecondition">
