<?xml version="1.0" encoding="utf-8"?>
<rdf:RDF
   xmlns:dcterms="http://purl.org/dc/terms/"
   xmlns:owl="http://www.w3.org/2002/07/owl#"
   xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
   xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
>
  <rdf:Description rdf:about="http://purl.org/dc/terms/license">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AnnotationProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://purl.org/ai4s/ontology/planning#addsPredicate">
    <rdfs:domain rdf:resource="https://purl.org/ai4s/ontology/planning#ActionEffect"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:range rdf:resource="http://purl.org/vocab/lifecycle/schema#State"/>
    <rdfs:comment>a property that relates an effect to a state that adds a predicate to it</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://purl.org/ai4s/ontology/planning#hasExtractedAction">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:range rdf:resource="https://purl.org/ai4s/ontology/planning#MacroAction"/>
    <rdfs:domain rdf:resource="https://purl.org/ai4s/ontology/planning#PlanningDomain"/>
    <rdfs:comment>a property that relates a planning domain to an action that is extracted from its plan</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/ontology#Phase">
    <rdfs:comment>A stage in the decommissioning process</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontology#ActionPrecondition"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://purl.org/ai4s/ontology/planning#solvedBy">
    <owl:inverseOf rdf:resource="https://purl.org/ai4s/ontology/planning#solvesRequirement"/>
    <rdfs:comment>a property that relates a domain requirement to a planner that solves it</rdfs:comment>
    <rdfs:domain rdf:resource="https://purl.org/ai4s/ontology/planning#DomainRequirement"/>
    <rdfs:range rdf:resource="https://purl.org/ai4s/ontology/planning#Planner"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/ontology#Material">
    <rdfs:comment>A material used in the decommissioning process</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontology#null"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/ontology#hasLevel">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:domain rdf:resource="http://www.semanticweb.org/ontology#Regulation | RadiationHazard"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://purl.org/ai4s/ontology/planning#hasMediumRelevancePlanner">
    <rdfs:range rdf:resource="https://purl.org/ai4s/ontology/planning#Planner"/>
    <rdfs:domain rdf:resource="https://purl.org/ai4s/ontology/planning#PlanningDomain"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:comment>a property that relates a planning domain to a planner that has a medium relevance score for it</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N831a6b4149314f318ae6e5ea62a5a881">
    <owl:onProperty rdf:resource="https://purl.org/ai4s/ontology/planning#hasRequirement"/>
    <owl:someValuesFrom rdf:resource="https://purl.org/ai4s/ontology/planning#DomainRequirement"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/ontology#TransportAction">
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontology#MacroAction"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment>An action for transporting a material</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://purl.org/ai4s/ontology/planning#InitialState">
    <rdfs:subClassOf rdf:resource="http://purl.org/vocab/lifecycle/schema#State"/>
    <rdfs:comment xml:lang="en">represents the starting or the given state of a planning problem</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://purl.org/ai4s/ontology/planning#PlanningDomain">
    <rdfs:subClassOf rdf:nodeID="N831a6b4149314f318ae6e5ea62a5a881"/>
    <rdfs:subClassOf rdf:nodeID="Nea6f46b98c8b433e85e00dd63d4db860"/>
    <rdfs:subClassOf rdf:nodeID="N572cb6b0781946a399363d1ad2f4f5f5"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">a class that represents a problem setting for automated planning</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#Plan">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:nodeID="N382d20601a4d4a438e52453cce82919f"/>
    <rdfs:subClassOf rdf:nodeID="Nccddf938f84e40e2a0e67f20bc510892"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N382d20601a4d4a438e52453cce82919f">
    <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#nonNegativeInteger"/>
    <owl:onProperty rdf:resource="https://purl.org/ai4s/ontology/planning#hasPlanCost"/>
    <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://purl.org/ai4s/ontology/planning#hasProblem">
    <rdfs:comment>a property that relates a planning domain to a planning problem that is defined in it</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://purl.org/ai4s/ontology/planning#PlanningDomain"/>
    <rdfs:range rdf:resource="https://purl.org/ai4s/ontology/planning#PlanningProblem"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://purl.org/ai4s/ontology/planning#PlanningProblem">
    <rdfs:comment xml:lang="en">represents a task of the planning domain that requires a plan to be solved</rdfs:comment>
    <rdfs:subClassOf rdf:nodeID="N28182090fd864e98a0a40a195a30cf2d"/>
    <rdfs:subClassOf rdf:nodeID="N18927a5577fa4af3b06f813dc2f423eb"/>
    <rdfs:subClassOf rdf:nodeID="N6b775f335e4742efbe9c71d283570620"/>
    <rdfs:subClassOf rdf:nodeID="N2ca6f2ff00f0404e84e571b9ac64a1ab"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://purl.org/ai4s/ontology/planning#DomainConstant">
    <rdfs:comment xml:lang="en">represents a fixed entity in a planning domain</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://purl.org/ai4s/ontology/planning#deletesPredicate">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://purl.org/ai4s/ontology/planning#ActionEffect"/>
    <rdfs:comment>a property that relates an effect to a state that deletes a predicate from it</rdfs:comment>
    <rdfs:range rdf:resource="http://purl.org/vocab/lifecycle/schema#State"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/ontology#DecommissioningStrategy">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment>A strategy for decommissioning a facility</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontology#null"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://purl.org/ai4s/ontology/planning">
    <owl:versionIRI rdf:resource="https://purl.org/ai4s/ontology/planning/v2.0"/>
    <dcterms:description>This ontology represents the knowledge about automated planning domain. It captures the characteristics, features, and performance of different planners and domains, as well as the relationships between them. The ontology can be used to select suitable planners for a given domain and to improve their performance. The ontology aims to facilitate automated planning research and applications.</dcterms:description>
    <dcterms:license>https://creativecommons.org/licenses/by/4.0/legalcode</dcterms:license>
    <dcterms:title>Ontology to model Automated Planning domain</dcterms:title>
    <dcterms:language>English</dcterms:language>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>
    <dcterms:contributor>Bharath Muppasani, Vishal Pallagani, Biplav Srivastava, Raghava Mutharaju</dcterms:contributor>
    <rdfs:seeAlso>https://github.com/BharathMuppasani/AI-Planning-Ontology</rdfs:seeAlso>
    <dcterms:creator>Bharath Muppasani</dcterms:creator>
    <owl:versionInfo rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2.0</owl:versionInfo>
  </rdf:Description>
  <rdf:Description rdf:about="https://purl.org/ai4s/ontology/planning#ActionPrecondition">
    <rdfs:comment xml:lang="en">a class that represents what needs to be true before an action can be done</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/ontology#manages">
    <rdfs:domain rdf:resource="http://www.semanticweb.org/ontology#Organization"/>
    <rdfs:range rdf:resource="http://www.semanticweb.org/ontology#Facility"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/ontology#isLocatedAt">
    <rdfs:domain rdf:resource="http://www.semanticweb.org/ontology#TransportAction | Regulation"/>
    <rdfs:domain rdf:resource="http://www.semanticweb.org/ontology#RadiationHazard | Material"/>
    <rdfs:range rdf:resource="http://www.semanticweb.org/ontology#Facility"/>
    <rdfs:range rdf:resource="http://www.semanticweb.org/ontology#Facility | xsd:string"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N6b775f335e4742efbe9c71d283570620">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="https://purl.org/ai4s/ontology/planning#hasInitialState"/>
    <owl:someValuesFrom rdf:resource="https://purl.org/ai4s/ontology/planning#InitialState"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N2d3f2384e6e043b4a6ebd9064c0b6555">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:someValuesFrom rdf:resource="http://purl.org/vocab/lifecycle/schema#State"/>
    <owl:onProperty rdf:resource="https://purl.org/ai4s/ontology/planning#addsPredicate"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://purl.org/ai4s/ontology/planning#hasActionExplanation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="http://caressesrobot.org/ontology#Action"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://purl.org/ai4s/ontology/planning#hasConstant">
    <rdfs:domain rdf:resource="https://purl.org/ai4s/ontology/planning#PlanningDomain"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:comment>a property that relates a planning domain to a domain constant that is defined in it</rdfs:comment>
    <rdfs:range rdf:resource="https://purl.org/ai4s/ontology/planning#DomainConstant"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://purl.org/ai4s/ontology/planning#PlannerType">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">a category or classification of planners based on their characteristics or features</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://purl.org/ai4s/ontology/planning#ofParameterType">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="http://caressesrobot.org/ontology#Parameter"/>
    <rdfs:range rdf:resource="https://purl.org/ai4s/ontology/planning#ParameterType"/>
    <rdfs:comment>a property that relates an action parameter to a type that classifies it</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://purl.org/ai4s/ontology/planning#hasAction">
    <rdfs:comment>a property that relates a planning domain to a domain action that is available in it</rdfs:comment>
    <rdfs:domain rdf:resource="https://purl.org/ai4s/ontology/planning#PlanningDomain"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:range rdf:resource="http://caressesrobot.org/ontology#Action"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://purl.org/ai4s/ontology/planning#hasModelReconciliationExplanation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:domain rdf:resource="https://purl.org/ai4s/ontology/planning#PlanningDomain"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/dc/terms/title">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AnnotationProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://purl.org/ai4s/ontology/planning#hasEffect">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="http://caressesrobot.org/ontology#Action"/>
    <rdfs:comment>a property that relates an action to an action effect that results from it</rdfs:comment>
    <rdfs:range rdf:resource="https://purl.org/ai4s/ontology/planning#ActionEffect"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Ncc64b57578a04bae95a1cb1fe089a7a8">
    <owl:onProperty rdf:resource="https://purl.org/ai4s/ontology/planning#deletesPredicate"/>
    <owl:someValuesFrom rdf:resource="http://purl.org/vocab/lifecycle/schema#State"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://purl.org/ai4s/ontology/planning#hasPredicate">
    <rdfs:comment>a property that relates a planning domain to a domain predicate that is defined in it</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:range rdf:resource="https://purl.org/ai4s/ontology/planning#DomainPredicate"/>
    <rdfs:domain rdf:resource="https://purl.org/ai4s/ontology/planning#PlanningDomain"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://purl.org/ai4s/ontology/planning#hasParameterType">
    <rdfs:comment>a property that relates a planning domain to a type</rdfs:comment>
    <rdfs:domain rdf:resource="https://purl.org/ai4s/ontology/planning#PlanningDomain"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:range rdf:resource="https://purl.org/ai4s/ontology/planning#ParameterType"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N572cb6b0781946a399363d1ad2f4f5f5">
    <owl:onProperty rdf:resource="https://purl.org/ai4s/ontology/planning#hasPredicate"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:someValuesFrom rdf:resource="https://purl.org/ai4s/ontology/planning#DomainPredicate"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/ontology#Organization">
    <rdfs:comment>An organization involved in the decommissioning process</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontology#null"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://purl.org/ai4s/ontology/planning#hasInitialState">
    <rdfs:domain rdf:resource="https://purl.org/ai4s/ontology/planning#PlanningProblem"/>
    <rdfs:comment>a property that relates a planning problem to an initial state that is given for it</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:range rdf:resource="https://purl.org/ai4s/ontology/planning#InitialState"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/ontology#RadiationHazard">
    <rdfs:comment>A hazard associated with radiation</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontology#DomainConstant"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/ontology#hasDuration">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:domain rdf:resource="http://www.semanticweb.org/ontology#Phase"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://purl.org/ai4s/ontology/planning#hasPlanCost">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#Plan"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#nonNegativeInteger"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/dc/terms/contributor">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AnnotationProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://purl.org/ai4s/ontology/planning#hasHighRelevancePlanner">
    <rdfs:comment>a property that relates a planning domain to a planner that has a high relevance score for it</rdfs:comment>
    <rdfs:domain rdf:resource="https://purl.org/ai4s/ontology/planning#PlanningDomain"/>
    <rdfs:range rdf:resource="https://purl.org/ai4s/ontology/planning#Planner"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Nccddf938f84e40e2a0e67f20bc510892">
    <owl:onProperty rdf:resource="https://purl.org/ai4s/ontology/planning#isGeneratedBy"/>
    <owl:someValuesFrom rdf:resource="https://purl.org/ai4s/ontology/planning#Planner"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/dc/terms/description">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AnnotationProperty"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Nea6f46b98c8b433e85e00dd63d4db860">
    <owl:someValuesFrom rdf:resource="http://caressesrobot.org/ontology#Action"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="https://purl.org/ai4s/ontology/planning#hasAction"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://purl.org/ai4s/ontology/planning#isGeneratedBy">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:range rdf:resource="https://purl.org/ai4s/ontology/planning#Planner"/>
    <rdfs:comment>a property that relates a plan to a planner that generates it</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#Plan"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://purl.org/ai4s/ontology/planning#MacroAction">
    <rdfs:subClassOf rdf:resource="http://caressesrobot.org/ontology#Action"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">Extracted macro action, which is a combination of multiple actions of a planning domain</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Neaa399ce4de14c5baa26e1695dbba941">
    <owl:onProperty rdf:resource="https://purl.org/ai4s/ontology/planning#ofPlannerType"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:someValuesFrom rdf:resource="https://purl.org/ai4s/ontology/planning#PlannerType"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://purl.org/ai4s/ontology/planning#hasPlanExplanation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:domain rdf:resource="http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#Plan"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://purl.org/ai4s/ontology/planning#hasRequirement">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:comment>a property that relates a planning domain or problem to a domain requirement that is required or supported by it</rdfs:comment>
    <rdfs:range rdf:resource="https://purl.org/ai4s/ontology/planning#DomainRequirement"/>
    <rdfs:domain rdf:resource="https://purl.org/ai4s/ontology/planning#PlanningDomain"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://purl.org/ai4s/ontology/planning#hasPrecondition">
    <rdfs:comment>a property that relates an action to an action precondition that is required for it</rdfs:comment>
    <rdfs:range rdf:resource="https://purl.org/ai4s/ontology/planning#ActionPrecondition"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="http://caressesrobot.org/ontology#Action"/>
  </rdf:Description>
