  </rdf:Description>
  <rdf:Description rdf:about="http://caressesrobot.org/ontology#Parameter">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">a class that represents what is involved in an action</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://purl.org/ai4s/ontology/planning#hasLowRelevancePlanner">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
