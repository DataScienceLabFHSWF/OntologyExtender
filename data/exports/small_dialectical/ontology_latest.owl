    <rdfs:comment xml:lang="en">a system that can generate plans for a given planning domain and problem</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/2024/planning-ontology#ProblemObject">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>ProblemObject</rdfs:label>
    <rdfs:comment>An object used to represent a problem in planning, with specific requirements for environmental impact assessments and safety measures.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="domainConstant"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://purl.org/ai4s/ontology/planning#PlannerType">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">a category or classification of planners based on their characteristics or features</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://purl.org/ai4s/ontology/planning#addsPredicate">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
