<?xml version="1.0" encoding="utf-8"?>
<rdf:RDF
   xmlns:dcterms="http://purl.org/dc/terms/"
   xmlns:owl="http://www.w3.org/2002/07/owl#"
   xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
   xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
>
  <rdf:Description rdf:about="https://purl.org/ai4s/ontology/planning#hasGoalState">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://purl.org/ai4s/ontology/planning#PlanningProblem"/>
    <rdfs:range rdf:resource="https://purl.org/ai4s/ontology/planning#GoalState"/>
    <rdfs:comment>a property that relates a planning problem to a goal state that is desired for it</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/2024/planning-ontology#Befehl">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Befehl</rdfs:label>
    <rdfs:comment>Orders or instructions required for performing the process of attenierung und entsorgung.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="domainConstant"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://purl.org/ai4s/ontology/planning#hasHighRelevancePlanner">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://purl.org/ai4s/ontology/planning#PlanningDomain"/>
    <rdfs:range rdf:resource="https://purl.org/ai4s/ontology/planning#Planner"/>
    <rdfs:comment>a property that relates a planning domain to a planner that has a high relevance score for it</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://purl.org/ai4s/ontology/planning#hasExtractedAction">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://purl.org/ai4s/ontology/planning#PlanningDomain"/>
    <rdfs:range rdf:resource="https://purl.org/ai4s/ontology/planning#MacroAction"/>
    <rdfs:comment>a property that relates a planning domain to an action that is extracted from its plan</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://purl.org/ai4s/ontology/planning#GoalState">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://purl.org/vocab/lifecycle/schema#State"/>
    <rdfs:comment xml:lang="en">represents a desired or a target state defined in a task that a plan should achieve</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://purl.org/ai4s/ontology/planning">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>
    <owl:versionIRI rdf:resource="https://purl.org/ai4s/ontology/planning/v2.0"/>
    <dcterms:contributor>Bharath Muppasani, Vishal Pallagani, Biplav Srivastava, Raghava Mutharaju</dcterms:contributor>
    <dcterms:creator>Bharath Muppasani</dcterms:creator>
    <dcterms:description>This ontology represents the knowledge about automated planning domain. It captures the characteristics, features, and performance of different planners and domains, as well as the relationships between them. The ontology can be used to select suitable planners for a given domain and to improve their performance. The ontology aims to facilitate automated planning research and applications.</dcterms:description>
    <dcterms:language>English</dcterms:language>
    <dcterms:license>https://creativecommons.org/licenses/by/4.0/legalcode</dcterms:license>
    <dcterms:title>Ontology to model Automated Planning domain</dcterms:title>
    <rdfs:seeAlso>https://github.com/BharathMuppasani/AI-Planning-Ontology</rdfs:seeAlso>
    <owl:versionInfo rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2.0</owl:versionInfo>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Nc48f3573f0de40478fd4e361d2765f93">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="https://purl.org/ai4s/ontology/planning#hasAction"/>
    <owl:someValuesFrom rdf:resource="http://caressesrobot.org/ontology#Action"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Nfe765443a8e348318fb309784cf1d8c8">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="https://purl.org/ai4s/ontology/planning#addsPredicate"/>
    <owl:someValuesFrom rdf:resource="http://purl.org/vocab/lifecycle/schema#State"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/2024/planning-ontology#Beteiligung">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Beteiligung</rdfs:label>
    <rdfs:comment>Participation or involvement required for performing the process of attenierung und entsorgung.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="domainConstant"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/2024/planning-ontology#AttenierungUndEntsorgung">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>AttenierungUndEntsorgung</rdfs:label>
    <rdfs:comment>The process of shutting down and decommissioning a nuclear power plant, with a focus on environmental safety and responsible waste management.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="domainConstant"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#Plan">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:nodeID="N1d9a5a6c465a4bf99332272a215d69da"/>
    <rdfs:subClassOf rdf:nodeID="Nb2f7c82e600a46448c395bb19d9e3694"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://purl.org/ai4s/ontology/planning#hasProblem">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://purl.org/ai4s/ontology/planning#PlanningDomain"/>
    <rdfs:range rdf:resource="https://purl.org/ai4s/ontology/planning#PlanningProblem"/>
    <rdfs:comment>a property that relates a planning domain to a planning problem that is defined in it</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N48e84176ef0b4bdd9c8f0fadfeb7757f">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="https://purl.org/ai4s/ontology/planning#hasPredicate"/>
    <owl:someValuesFrom rdf:resource="https://purl.org/ai4s/ontology/planning#DomainPredicate"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://purl.org/ai4s/ontology/planning#PlanningProblem">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:nodeID="N72db7b7b30354f338f9687d1e193535e"/>
    <rdfs:subClassOf rdf:nodeID="N09b24ba2104d440594f330e02604d58b"/>
    <rdfs:subClassOf rdf:nodeID="N86cf55cbd46846ec8a2d46dec320a331"/>
    <rdfs:subClassOf rdf:nodeID="Na5f7426beca74ce6850bff3696aaf0e1"/>
    <rdfs:comment xml:lang="en">represents a task of the planning domain that requires a plan to be solved</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/2024/planning-ontology#Verfahren">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Verfahren</rdfs:label>
    <rdfs:comment>Procedures or methods used for performing the process of attenierung und entsorgung.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="domainConstant"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://purl.org/ai4s/ontology/planning#hasInitialState">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://purl.org/ai4s/ontology/planning#PlanningProblem"/>
    <rdfs:range rdf:resource="https://purl.org/ai4s/ontology/planning#InitialState"/>
    <rdfs:comment>a property that relates a planning problem to an initial state that is given for it</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/2024/planning-ontology#Wirtschaft">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Wirtschaft</rdfs:label>
    <rdfs:comment>Economic considerations or impact assessments required for performing the process of attenierung und entsorgung.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="domainConstant"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://purl.org/ai4s/ontology/planning#hasPlan">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://purl.org/ai4s/ontology/planning#PlanningProblem"/>
    <rdfs:range rdf:resource="http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#Plan"/>
    <rdfs:comment>a property that relates a planning problem to a plan that solves it</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/2024/planning-ontology#PlannedAction">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>PlannedAction</rdfs:label>
    <rdfs:comment>A planned action to be taken in a planning scenario, with specific requirements for environmental impact assessments and safety measures.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="domainConstant"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/2024/planning-ontology#Regierung">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Regierung</rdfs:label>
    <rdfs:comment>The government or regulatory body responsible for overseeing the process of attenierung und entsorgung.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="domainConstant"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/2024/planning-ontology#PlanningProcess">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>PlanningProcess</rdfs:label>
    <rdfs:comment>A process used to plan and solve planning problems, with specific requirements for environmental impact assessments and safety measures.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="domainConstant"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://purl.org/ai4s/ontology/planning#hasEffect">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="http://caressesrobot.org/ontology#Action"/>
    <rdfs:range rdf:resource="https://purl.org/ai4s/ontology/planning#ActionEffect"/>
    <rdfs:comment>a property that relates an action to an action effect that results from it</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://purl.org/ai4s/ontology/planning#solvedBy">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <owl:inverseOf rdf:resource="https://purl.org/ai4s/ontology/planning#solvesRequirement"/>
    <rdfs:domain rdf:resource="https://purl.org/ai4s/ontology/planning#DomainRequirement"/>
    <rdfs:range rdf:resource="https://purl.org/ai4s/ontology/planning#Planner"/>
    <rdfs:comment>a property that relates a domain requirement to a planner that solves it</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N62b3a80a764a4db2925a07e8f618c493">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="https://purl.org/ai4s/ontology/planning#hasEffect"/>
    <owl:someValuesFrom rdf:resource="https://purl.org/ai4s/ontology/planning#ActionEffect"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/2024/planning-ontology#Atomgesetz">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Atomgesetz</rdfs:label>
    <rdfs:comment>Regulatory framework or laws governing the process of attenierung und entsorgung.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="domainConstant"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N3478f12c64994215be286ec17260207a">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
