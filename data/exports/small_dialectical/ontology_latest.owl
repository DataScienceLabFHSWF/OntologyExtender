    <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#nonNegativeInteger"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://purl.org/ai4s/ontology/planning#ActionEffect">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:nodeID="Nfe765443a8e348318fb309784cf1d8c8"/>
