# OntologyExtender – Environment Variables
# Copy this file to `.env` and adjust for your setup.
#
# STANDALONE: `docker compose up -d` spins up Fuseki + Ollama.
# PLATFORM:   env vars are overridden by KGPlatform's docker-compose.yml.

# ── Fuseki ─────────────────────────────────────────────────────
HITL_FUSEKI_DATASET=kgbuilder
HITL_FUSEKI_STAGING_DATASET=kgbuilder-staging
HITL_FUSEKI_PASSWORD=admin
# Host port for Fuseki (standalone only)
FUSEKI_PORT=3030

# ── Ollama ─────────────────────────────────────────────────────
# Model is pulled automatically on `docker compose up`.
# For benchmarking, pull additional models manually:
#   docker exec ontology-ollama ollama pull llama3.2:3b
#   docker exec ontology-ollama ollama pull nemotron-3-nano
#   docker exec ontology-ollama ollama pull qwen3-next:latest
HITL_OLLAMA_MODEL=qwen3:8b
HITL_LLM_TEMPERATURE=0.5
# Endpoint of the Ollama server. Default points at the OntologyExtender
# container. To use the shared gemma4/nemotron container (kgbuilder), set:
#   HITL_OLLAMA_URL=http://localhost:18134
#   HITL_OLLAMA_MODEL=gemma4:e4b   # or gemma4:31b / gemma4:e2b
HITL_OLLAMA_URL=http://localhost:18135
# Host port for Ollama (standalone only)
OLLAMA_PORT=11437

# ── Logical Reasoner gate ──────────────────────────────────────
# Deterministic OWL consistency check run in every debate round.
# Disable (=false) to reproduce the pre-Reasoner 3-agent baseline.
HITL_REASONER_ENABLED=true
HITL_REASONER_LLM_EXPLANATIONS=true

# ── Cross-service URLs ─────────────────────────────────────────
# Leave empty for standalone, set for platform integration.
KGBUILDER_API_URL=

# ── API service ────────────────────────────────────────────────
UVICORN_PORT=8003

# ── Gap Analysis ───────────────────────────────────────────────
HITL_MIN_ENTITY_FREQUENCY=3
HITL_SEMANTIC_SIMILARITY_THRESHOLD=0.65

# ── Evaluation Targets ─────────────────────────────────────────
HITL_CQ_ANSWERABILITY_TARGET=0.80
HITL_ENTITY_COVERAGE_TARGET=0.80

# ── Weights & Biases (optional) ────────────────────────────────
HITL_WANDB_ENABLED=false
HITL_WANDB_ENTITY=
HITL_WANDB_PROJECT=ontology-hitl
HITL_WANDB_API_KEY=

# ── Paths ──────────────────────────────────────────────────────
HITL_SEED_ONTOLOGY_PATH=data/seed_ontology/plan-ontology-v1.0.owl
HITL_ITERATIONS_DIR=data/iterations
HITL_EXPORTS_DIR=data/exports
