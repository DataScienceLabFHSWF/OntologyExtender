# Default board and frame context used when prompts omit Miro URLs
MIRO_DEFAULT_BOARD_ID=example-board-id
MIRO_DEFAULT_BOARD_URL=example-board-url
MIRO_DEFAULT_FRAME_URL=example-frame-url

# Local LLaMA endpoint (OpenAI-compatible)
# For Ollama: http://localhost:11434/v1
LOCAL_LLM_BASE_URL=http://localhost:11434/v1
LOCAL_LLM_MODEL=llama3.1:8b
LOCAL_LLM_API_KEY=not-needed-for-ollama

# Official remote Miro MCP server settings
MIRO_MCP_URL=https://mcp.miro.com/
MIRO_X_AI_SOURCE=local-llama-bridge

# Optional: use your own Miro OAuth app credentials.
# If left empty, the MCP OAuth client can use dynamic client registration.
MIRO_OAUTH_CLIENT_ID=
MIRO_OAUTH_CLIENT_SECRET=
MIRO_OAUTH_REDIRECT_URI=http://127.0.0.1:8765/callback
MIRO_OAUTH_STORAGE_FILE=.miro_oauth_tokens.json

# Optional local skill context injected into model system prompts
MIRO_SKILL_CONTEXT_FILE=SKILL.md
